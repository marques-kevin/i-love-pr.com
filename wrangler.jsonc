{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ilovepr",
  "compatibility_date": "2026-08-09",
  // Pure static Vite build — no Worker script. This is Cloudflare's
  // current replacement for a classic Pages static site.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
